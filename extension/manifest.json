{
  "manifest_version": 3,
  "name": "Nuclei Remote",
  "version": "1.3.1",
  "description": "Run Nuclei scans on your own server over HTTP/HTTPS with API key authentication.",
  "permissions": [
    "storage",
    "activeTab"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Nuclei Remote"
  }
}
