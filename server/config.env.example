# Copy to config.env and fill in your settings. This file is sourced by bash.
# Generate a token: python3 -c 'import secrets; print(secrets.token_hex(32))'
NUCLEI_API_TOKEN='PASTE_GENERATED_TOKEN_AT_LEAST_32_CHARACTERS'
# Set the full path returned by: command -v nuclei
NUCLEI_BIN='/home/YOUR_USERNAME/go/bin/nuclei'
NUCLEI_RESULTS_DIR='./results'
NUCLEI_API_PORT='8765'
# 0.0.0.0 exposes the API on all IPv4 interfaces.
NUCLEI_API_HOST='0.0.0.0'
NUCLEI_LOG_DIR='./logs'
# Optional HTTPS: the certificate must be trusted by the browser.
NUCLEI_TLS_CERT=''
NUCLEI_TLS_KEY=''
